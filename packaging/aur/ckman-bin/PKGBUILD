# Maintainer: Canokeys <https://github.com/canokeys>
#
# Publish to the AUR (needs an AUR account with an SSH key):
#   git clone ssh://aur@aur.archlinux.org/ckman-bin.git aur-ckman-bin
#   cp PKGBUILD aur-ckman-bin/
#   cd aur-ckman-bin && makepkg --printsrcinfo > .SRCINFO
#   git add PKGBUILD .SRCINFO && git commit -m "ckman-bin 0.1.5" && git push
pkgname=ckman-bin
pkgver=0.1.5
pkgrel=1
pkgdesc="CanoKey management CLI (device config, OATH, PIV, OpenPGP, FIDO2)"
arch=('x86_64' 'aarch64')
url="https://github.com/canokeys/canokey-manager"
license=('Apache-2.0')
depends=('pcsclite' 'systemd-libs' 'ccid')
provides=('ckman')
conflicts=('ckman')
source_x86_64=("${url}/releases/download/v${pkgver}/ckman-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("${url}/releases/download/v${pkgver}/ckman-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('75f21d2aa737e73b3cd3adb963176d425b18662dc5d273acbc89cd3163e67591')
sha256sums_aarch64=('c1f2509a216d858c31b2ecd8348c4d84d98a231a57a6fd3e028f0d738da5c8ed')

package() {
    cd "${srcdir}/ckman-${CARCH}-unknown-linux-gnu"
    install -Dm755 ckman "${pkgdir}/usr/bin/ckman"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
